# Data (regenerable from raw MovieLens download + pipeline scripts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Checkpoints (large, regenerable, and often stored on Google Drive instead)
*.pt
*.pth

# MLflow local tracking store
mlruns/
mlartifacts/
mlflow.db

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Environment
.env

# OS
.DS_Store

# Editors
.vscode/
.idea/
